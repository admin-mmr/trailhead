                        <option value="medium" {% if annotation and annotation['difficulty'] == 'medium' %}selected{% endif %}>Medium</option>
                        <option value="hard" {% if annotation and annotation['difficulty'] == 'hard' %}selected{% endif %}>Hard</option>
                        <option value="edge" {% if annotation and annotation['difficulty'] == 'edge' %}selected{% endif %}>Edge</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Bib correct?</label>
                    <select name="bib_correct">
                        <option value="">—</option>
                        <option value="1" {% if annotation and annotation['bib_correct'] == 1 %}selected{% endif %}>Yes</option>
                        <option value="0" {% if annotation and annotation['bib_correct'] == 0 %}selected{% endif %}>No</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="f-bib-override">Bib override</label>
                    <input type="text" name="bib_override" id="f-bib-override"
