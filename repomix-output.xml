                  <button
                    className="btn btn-outline"
                    onClick={() => {
                      setSelectedDistrictMember(null);
                      setDistrictSearchQuery('');
                      setDistrictSearchResults([]);
                      setSelectedDistrict('');
                      setDistrictError('');
                    }}
                    disabled={districtSaving}
                  >
                    Cancel
                  </button>
                </div>
              </div>
            </div>
          )}
        </div>
      )}
    </div>
  );
};

// Expose for index.html
