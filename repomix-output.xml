    <a href="{{ url_for('review_photo', idx=next_idx) }}">Next &rarr;</a>
</div>

<div class="review-layout">
    <!-- Left: Photo with overlay -->
    <div>
        <div class="review-image-wrap" id="image-wrap">
            <img id="review-img"
                 src="{{ url_for('serve_photo', idx=idx) }}"
                 alt="{{ rec.file_name }}"
                 onload="drawOverlays()">
