    ├── README.md
    ├── python/
    │   ├── google_workspace.py        ← Drive + Sheets API wrapper
    │   └── mysql_sync.py              ← Member sync to MySQL
    ├── schemas/
    │   └── members.sql                ← Source-of-truth schema
    ├── migrations/                    ← Versioned DB changes
    ├── ops/                           ← Cron jobs, monitoring
    └── docs/                          ← Shared documentation
```

