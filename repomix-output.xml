                    <span className="text-gray-400 ml-1 font-normal text-xs">{lang === 'zh' ? '（选填）' : '(optional)'}</span>
                  </label>
                  <input
                    type="tel"
                    value={info.phone}
                    onChange={e => handleInfoChange('phone', e.target.value)}
                    onBlur={e => handleInfoBlur('phone', e.target.value)}
