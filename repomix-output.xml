                </div>

                <div class="form-group">
                    <label>Face match correct?</label>
                    <select name="face_correct">
                        <option value="">—</option>
                        <option value="1" {% if annotation and annotation['face_correct'] == 1 %}selected{% endif %}>Yes</option>
                        <option value="0" {% if annotation and annotation['face_correct'] == 0 %}selected{% endif %}>No</option>
