                    fontFamily: 'monospace'
                  }}>
                    {result.traceback}
                  </pre>
                </details>
              )}
            </div>
          )}
        </div>
      )}

      {toast && <Toast message={toast} onClose={() => setToast('')} />}
    </div>
  );
};

});
