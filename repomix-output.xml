  document.addEventListener('DOMContentLoaded', initLanguageSelector);

console.log('[MMR][family] page script started');
var appBaseUrl = '__SCRIPT_URL__';

  // Navigate top frame (GAS iframe requires target="_top")
  function navigateToPage(page) {
    var url = appBaseUrl + '?page=' + page;
    console.log('[MMR] navigateToPage:', url);
    var a = document.createElement('a');
    a.href = url;
    a.target = '_top';
    a.style.display = 'none';
    document.body.appendChild(a);
    a.click();
  }
// Fallback: if server substitution failed, use current location
(function() {
  if (!appBaseUrl || appBaseUrl.indexOf('http') !== 0) {
    var _h = window.location.href;
    appBaseUrl = _h.indexOf('?') !== -1 ? _h.substring(0, _h.indexOf('?')) : _h;
  }
})();
const SERVER_PARAMS = __URL_PARAMS__;
let member = null;
let familyMembers = [];

function callApi(fn, payload) {
  console.log('[MMR][family] callApi:', fn);
  return new Promise((resolve, reject) => {
    const req = { requestId: Math.random().toString(36).slice(2), payload };
    google.script.run
      .withSuccessHandler(r => {
        const res = JSON.parse(r);
        if (res.ok) resolve(res.payload);
        else reject(new Error(res.errorMessage || 'API error'));
      })
      .withFailureHandler(err => reject(err))
      [fn](JSON.stringify(req));
  });
}

function showMsg(text, type = 'success') {
  const el = document.getElementById('msg');
  el.textContent = text;
  el.className = 'msg ' + type;
  el.scrollIntoView({ behavior: 'smooth' });
}

function formatDate(dateStr) {
  if (!dateStr) return '—';
  const d = new Date(dateStr);
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}

function getStatusBadge(status) {
  if (status === 'active') return '<span class="badge badge-active">active</span>';
  if (status === 'pending_upgrade') return '<span class="badge badge-pending">pending</span>';
  return '<span class="badge badge-inactive">inactive</span>';
}

// Load family members table
async function loadFamilyMembers() {
  try {
    console.log('[MMR][family] loading family members for:', member?.memberID);
    const result = await callApi('getFamilyMembers', {
      memberID: member.memberID,
      
    });

    familyMembers = result.members || [];
    console.log('[MMR][family] loaded members:', familyMembers.length);

    const tbody = document.getElementById('membersBody');
    const noMembers = document.getElementById('noMembers');

    if (familyMembers.length === 0) {
      tbody.innerHTML = '';
      noMembers.style.display = 'block';
      noMembers.textContent = 'No family members yet. Add one below!';
      return;
    }

    noMembers.style.display = 'none';
    tbody.innerHTML = familyMembers.map(m => `
      <tr>
        <td><strong>${m.memberID}</strong></td>
        <td>${m.firstName} ${m.lastName}</td>
        <td>${m.email}</td>
        <td>${m.type}</td>
        <td>${getStatusBadge(m.status)}</td>
        <td>${formatDate(m.expiration)}</td>
        <td>${m.wechatID || '—'}</td>
        <td>
          ${m.memberID === member.memberID ?
            '<em style="color:#999">Primary</em>' :
            `<button class="btn btn-danger" onclick="removeMember('${m.email}')">` + t('btnRemove') + `</button>`
          }
        </td>
      </tr>
    `).join('');
  } catch (err) {
    console.error('[MMR][family] loadFamilyMembers error:', err);
    showMsg('Failed to load family members: ' + err.message, 'error');
  }
}

// Look up an email
async function lookupEmail() {
  const email = document.getElementById('lookupEmail').value.trim();
  if (!email) {
    showMsg('Please enter an email address', 'error');
    return;
  }

  try {
    console.log('[MMR][family] looking up email:', email);
    const result = await callApi('lookupEmailForFamily', { email });

    const resultDiv = document.getElementById('lookupResult');
    const contentDiv = document.getElementById('resultContent');
    const createForm = document.getElementById('createNewMemberForm');

    if (result.exists) {
      // Member found
      console.log('[MMR][family] member found:', result.member.memberID);
      contentDiv.innerHTML = `
        <p style="margin-bottom: 12px;"><strong>${result.member.firstName} ${result.member.lastName}</strong></p>
        <p style="color: #666; font-size: 13px; margin-bottom: 12px;">
          Email: ${result.member.email}<br/>
          Member ID: ${result.member.memberID}
        </p>
        <button class="btn btn-primary" onclick="addExistingMember('${email}')">` + t('btnAdd') + `</button>
      `;
      resultDiv.classList.add('show');
      createForm.classList.add('section-hidden');
    } else {
      // Member not found
      console.log('[MMR][family] member not found, showing create form');
      contentDiv.innerHTML = `
        <p style="color: #c62828; margin-bottom: 12px;">
          ⚠️ No member found with this email.
        </p>
        <p style="color: #666; font-size: 13px;">
          You can create a new member with this email.
        </p>
      `;
      resultDiv.classList.add('show');

      // Show new member form
      document.getElementById('newEmail').value = email;
      createForm.classList.remove('section-hidden');
      createForm.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  } catch (err) {
    console.error('[MMR][family] lookupEmail error:', err);
    showMsg('Lookup failed: ' + err.message, 'error');
  }
}

// Add an existing member to the family
async function addExistingMember(email) {
  try {
    console.log('[MMR][family] adding existing member:', email);
    document.getElementById('lookupBtn').disabled = true;

    const result = await callApi('addFamilyMember', {
      memberID: member.memberID,
      targetEmail: email,
      
    });

    showMsg(`✅ ${result.message}`, 'success');

    // Reset form and reload
    document.getElementById('lookupEmail').value = '';
    document.getElementById('lookupResult').classList.remove('show');
    document.getElementById('createNewMemberForm').classList.add('section-hidden');
    document.getElementById('lookupBtn').disabled = false;

    await loadFamilyMembers();
  } catch (err) {
    console.error('[MMR][family] addExistingMember error:', err);
    showMsg('Failed to add member: ' + err.message, 'error');
    document.getElementById('lookupBtn').disabled = false;
  }
}

// Submit new member form
async function submitNewMember() {
  const email = document.getElementById('newEmail').value.trim();
  const firstName = document.getElementById('newFirstName').value.trim();
  const lastName = document.getElementById('newLastName').value.trim();
  const phoneNumber = document.getElementById('newPhoneNumber').value.trim();
  const district = document.getElementById('newDistrict').value.trim();

  if (!firstName) {
    showMsg('First name is required', 'error');
    return;
  }

  try {
    console.log('[MMR][family] creating new member:', email);

    // Step 1: Create the new member
    const createResult = await callApi('createNewMember', {
      email,
      firstName,
      lastName,
      phoneNumber,
      district,
      
    });

    console.log('[MMR][family] new member created:', createResult.member.memberID);

    // Step 2: Add to family
    const addResult = await callApi('addFamilyMember', {
      memberID: member.memberID,
      targetEmail: email,
      
    });

    showMsg(`✅ New member created and added to family!`, 'success');

    // Reset form
    document.getElementById('lookupEmail').value = '';
    document.getElementById('newFirstName').value = '';
    document.getElementById('newLastName').value = '';
    document.getElementById('newPhoneNumber').value = '';
    document.getElementById('newDistrict').value = '';
    document.getElementById('lookupResult').classList.remove('show');
    document.getElementById('createNewMemberForm').classList.add('section-hidden');

    await loadFamilyMembers();
  } catch (err) {
    console.error('[MMR][family] submitNewMember error:', err);
    showMsg('Failed to create member: ' + err.message, 'error');
  }
}

// Cancel new member form
function cancelNewMember() {
  document.getElementById('createNewMemberForm').classList.add('section-hidden');
  document.getElementById('lookupResult').classList.remove('show');
  document.getElementById('lookupEmail').value = '';
  document.getElementById('newFirstName').value = '';
  document.getElementById('newLastName').value = '';
  document.getElementById('newPhoneNumber').value = '';
  document.getElementById('newDistrict').value = '';
}

// Remove a family member
async function removeMember(email) {
  const targetName = familyMembers.find(m => m.email === email)?.firstName || email;
  if (!confirm(`Remove ${targetName} from the family?`)) {
    return;
  }

  try {
    console.log('[MMR][family] removing member:', email);
    const result = await callApi('removeFamilyMember', {
      memberID: member.memberID,
      targetEmail: email,
      
    });

    showMsg(`✅ ${result.message}`, 'success');
    await loadFamilyMembers();
  } catch (err) {
    console.error('[MMR][family] removeMember error:', err);
    showMsg('Failed to remove member: ' + err.message, 'error');
  }
}

// ---- Init ----
document.addEventListener('DOMContentLoaded', async () => {
  try {
    const cached = sessionStorage.getItem('member');
    if (cached) member = JSON.parse(cached);

    if (!member) {
      showMsg('Not authenticated. Please log in again.', 'error');
      return;
    }

    console.log('[MMR][family] initialized for member:', member.memberID);

    // Load family members
    await loadFamilyMembers();
  } catch (err) {
    console.error('[MMR][family] init error:', err);
    showMsg('Failed to load page: ' + err.message, 'error');
  }
});
</script>
</body>
</html>
</file>

<file path="web-apps/gas/membership/frontend/page_login.html">
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Misty Mountain Runners — Login</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #f5f5f5; min-height: 100vh;
      display: flex; align-items: center; justify-content: center;
    }
    .card {
      background: #fff; border-radius: 16px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.10);
      padding: 40px 32px; width: 100%; max-width: 400px;
    }
    .logo { text-align: center; font-size: 40px; margin-bottom: 8px; }
    .header-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; }
    .app-title { text-align: center; font-size: 22px; font-weight: 700; color: #1a1a1a; flex: 1; }
    .language-selector { padding: 6px 10px; border-radius: 6px; border: 1px solid #ddd; background: #f9f9f9; color: #333; font-size: 13px; font-weight: 500; cursor: pointer; }
    .language-selector:hover { background: #f0f0f0; }
    .subtitle { text-align: center; font-size: 14px; color: #777; margin-bottom: 28px; }

    /* Messages */
    .msg { font-size: 14px; padding: 10px 14px; border-radius: 8px; margin-bottom: 16px; display: none; }
    .msg.success { background: #e8f5e9; color: #2d7d46; display: block; }
    .msg.error   { background: #fdecea; color: #c62828; display: block; }
    .msg.info    { background: #e3f2fd; color: #1565c0; display: block; }

    /* Inputs */
    input[type="email"], input[type="text"] {
      width: 100%; padding: 13px 14px;
      border: 1.5px solid #ddd; border-radius: 10px;
      font-size: 15px; margin-bottom: 12px;
      transition: border-color 0.2s;
    }
    input:focus { border-color: #2d7d46; outline: none; }

    /* Buttons */
    .btn {
      width: 100%; padding: 13px;
      border-radius: 10px; border: none;
      font-size: 15px; font-weight: 600;
      cursor: pointer; transition: background 0.2s;
      margin-bottom: 10px;
    }
    .btn:disabled { opacity: 0.55; cursor: not-allowed; }
    .btn-primary   { background: #2d7d46; color: #fff; }
    .btn-primary:hover:not(:disabled) { background: #235f36; }
    .btn-google    { background: #fff; color: #333; border: 1.5px solid #ddd; }
    .btn-google:hover:not(:disabled) { background: #f5f5f5; }
    .btn-outline   { background: #fff; color: #2d7d46; border: 1.5px solid #2d7d46; }
    .btn-outline:hover:not(:disabled) { background: #f0f8f2; }
    .btn-ghost {
      background: none; border: none; color: #888;
      font-size: 13px; cursor: pointer; padding: 4px 0;
      text-decoration: underline; width: auto; margin-bottom: 0;
    }
    .btn-ghost:hover { color: #444; }

    .divider { display: flex; align-items: center; gap: 10px; margin: 18px 0; color: #bbb; font-size: 13px; }
    .divider::before, .divider::after { content: ''; flex: 1; height: 1px; background: #eee; }

    /* Result boxes */
    .result-box {
      border-radius: 10px; padding: 18px 16px; margin-bottom: 20px; text-align: center;
    }
    .result-box.returning { background: #e8f5e9; border: 1px solid #a5d6a7; }
    .result-box.new-member { background: #e3f2fd; border: 1px solid #90caf9; }
    .result-box .result-icon { font-size: 28px; margin-bottom: 6px; }
    .result-box h3 { font-size: 17px; font-weight: 700; color: #1a1a1a; margin-bottom: 4px; }
    .result-box p  { font-size: 13px; color: #555; line-height: 1.5; }

    /* OTP sub-section */
    .otp-section { margin-top: 20px; border-top: 1px solid #f0f0f0; padding-top: 20px; }
    .otp-section label { font-size: 13px; color: #555; display: block; margin-bottom: 6px; }

    /* Spinner */
    .spinner {
      display: inline-block; width: 16px; height: 16px;
      border: 2px solid rgba(255,255,255,0.4);
      border-top-color: #fff; border-radius: 50%;
      animation: spin 0.7s linear infinite; margin-right: 6px; vertical-align: middle;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    #dbg { font-size: 11px; color: #bbb; margin-top: 12px; text-align: center; }

    /* not show Google loginn for now since it requires extra setup and isn't the primary path in the current codebase */
    #googleBtn, #googleSpinner, .divider { display: none; }

  </style>
</head>
<body>
<div class="card">
  <div class="logo">🏃</div>
  <div class="header-row">
    <div class="app-title" id="appTitle" data-i18n="appTitle">Misty Mountain Runners</div>
    <select id="languageSelector" class="language-selector">
      <option value="en">English</option>
      <option value="zh">中文</option>
    </select>
  </div>

  <!-- ═══════════════════════════════════════════
       STATE 1: Email entry + Google sign-in
  ════════════════════════════════════════════ -->
  <div id="state-email">
    <p class="subtitle" data-i18n="subtitle">Sign in or register</p>
    <div id="msg-email" class="msg"></div>

    <button class="btn btn-google" id="googleBtn" onclick="loginWithGoogle()" style="display:none;">
      <img src="https://www.google.com/favicon.ico"
           style="width:16px;height:16px;vertical-align:middle;margin-right:8px;" />
      Sign in with Google
    </button>
    <span id="googleSpinner" style="display:none;"><span class="spinner"></span></span>

    <div class="divider"  style="display:none;">or sign in with email</div>

    <input type="email" id="emailInput"
           placeholder="your@email.com"
           onkeydown="if(event.key==='Enter') checkEmail()" />
    <button class="btn btn-primary" id="checkEmailBtn" onclick="checkEmail()" data-i18n="checkEmailBtn">Continue →</button>
  </div>

  <!-- ═══════════════════════════════════════════
       STATE 2A: Returning member found
  ════════════════════════════════════════════ -->
  <div id="state-returning" style="display:none">
    <div class="result-box returning">
      <div class="result-icon">👋</div>
      <h3><span data-i18n="welcomeBack">Welcome back</span>, <span id="returning-name"></span>!</h3>
      <p><span data-i18n="memberIDLabel">Member ID</span>: <strong id="returning-memberid"></strong></p>
    </div>

    <div id="msg-returning" class="msg"></div>

    <div class="otp-section">
      <label data-i18n="otpLabel">Enter your one-time login code, or request a new one.</label>
      <input type="text" id="otpInput-returning"
             placeholder="6-digit code" maxlength="6"
             inputmode="numeric" autocomplete="one-time-code"
             onkeydown="if(event.key==='Enter') verifyOtp('returning')" />
      <button class="btn btn-primary" id="verifyBtn-returning"
              onclick="verifyOtp('returning')" data-i18n="verifyBtn">
        Verify Code →
      </button>
      <button class="btn btn-outline" id="sendBtn-returning"
              onclick="sendOtp('returning')" data-i18n="sendNewCodeBtn">
        Send Me a New Code
      </button>
      <button class="btn-ghost" onclick="goBack()" data-i18n="backBtn">← Try a different email</button>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════
       STATE 2B: Email not found — ask intent
  ════════════════════════════════════════════ -->
  <div id="state-new-ask" style="display:none">
    <div class="result-box new-member">
      <div class="result-icon">✉️</div>
      <h3 data-i18n="noAccountTitle">No account found</h3>
      <p>We don't have a record for<br/><strong id="new-ask-email"></strong></p>
    </div>

    <div id="msg-new-ask" class="msg"></div>
    <p style="font-size:14px;color:#444;margin-bottom:16px;text-align:center;" data-i18n="areYouNewMember">
      Are you a new member?
    </p>

    <button class="btn btn-primary" id="newMemberYesBtn"
            onclick="startNewMemberOtp()" data-i18n="newMemberYes">
      Yes — Register Me →
    </button>
    <button class="btn-ghost" style="display:block;text-align:center;width:100%;margin-top:4px;"
            onclick="goBack()" data-i18n="newMemberNo">
      ← No, go back and change email
    </button>
  </div>

  <!-- ═══════════════════════════════════════════
       STATE 2B-verify: New member OTP entry
  ════════════════════════════════════════════ -->
  <div id="state-new-verify" style="display:none">
    <div class="result-box new-member">
      <div class="result-icon">✉️</div>
      <h3 data-i18n="verifyEmailTitle">Verify your email</h3>
      <p>Code sent to<br/><strong id="new-verify-email"></strong></p>
    </div>

    <div id="msg-new-verify" class="msg"></div>

    <div class="otp-section">
      <label data-i18n="codeFromInbox">Enter the 6-digit code from your inbox.</label>
      <input type="text" id="otpInput-new"
             placeholder="6-digit code" maxlength="6"
             inputmode="numeric" autocomplete="one-time-code"
             onkeydown="if(event.key==='Enter') verifyOtp('new')" />
      <button class="btn btn-primary" id="verifyBtn-new"
              onclick="verifyOtp('new')" data-i18n="verifyBtn">
        Verify Code →
      </button>
      <button class="btn btn-outline" id="sendBtn-new"
              onclick="sendOtp('new')" data-i18n="resendCodeBtn">
        Resend Code
      </button>
      <button class="btn-ghost" onclick="goBack()" data-i18n="goBackBtn">← Go back</button>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════
       FINAL: Continue button (after OTP verified)
  ════════════════════════════════════════════ -->
  <div id="state-continue" style="display:none">
    <div id="continue-msg" style="margin-bottom:20px;"></div>
    <button class="btn btn-primary" id="continueBtn" onclick="onContinueClick()" data-i18n="continueBtn">
      Continue →
    </button>
  </div>

  <div id="dbg"></div>
</div>

<script>
  // ── i18n ─────────────────────────────────────────────────
  var TRANSLATIONS = {
    "en": {
        "appTitle": "🏃 Misty Mountain Runners",
        "subtitle": "Sign in or register",
        "checkEmailBtn": "Continue →",
        "checking": "Checking",
        "otpLabel": "Enter your one-time login code, or request a new one.",
        "verifyBtn": "Verify Code →",
        "verifying": "Verifying",
        "sending": "Sending",
        "sendNewCodeBtn": "Send Me a New Code",
        "resendCodeBtn": "Resend Code",
        "backBtn": "← Try a different email",
        "welcomeBack": "Welcome back",
        "memberIDLabel": "Member ID",
        "noAccountTitle": "No account found",
        "newMemberYes": "Yes — Register Me →",
        "newMemberNo": "No — Try a different email",
        "sendingCode": "Sending code",
        "areYouNewMember": "Are you a new member?",
        "verifyEmailTitle": "Verify your email",
        "codeFromInbox": "Enter the 6-digit code from your inbox.",
        "goBackBtn": "← Go back",
        "otpInfoMsg": "Enter your login code from your email, or click below to request a new one.",
        "continueBtn": "Continue →",
        "loading": "Loading",
        "invalidEmail": "Please enter a valid email address.",
        "emailVerified": "Email verified!",
        "setupAccount": "Let's set up your account for"
    },
    "zh": {
        "appTitle": "🏃 岚山跑团",
        "subtitle": "登录或注册",
        "checkEmailBtn": "继续 →",
        "checking": "正在检查",
        "otpLabel": "请输入一次性验证码，或申请新验证码。",
        "verifyBtn": "验证 →",
        "verifying": "正在验证",
        "sending": "正在发送",
        "sendNewCodeBtn": "发送新验证码",
        "resendCodeBtn": "重新发送验证码",
        "backBtn": "← 更换邮箱",
        "welcomeBack": "欢迎回来",
        "memberIDLabel": "会员编号",
        "noAccountTitle": "未找到账号",
        "newMemberYes": "是，帮我注册 →",
        "newMemberNo": "否 — 更换邮箱",
        "sendingCode": "正在发送验证码",
        "areYouNewMember": "您是新会员吗？",
        "verifyEmailTitle": "验证您的邮箱",
        "codeFromInbox": "请输入您收件箱中的6位验证码。",
        "goBackBtn": "← 返回",
        "otpInfoMsg": "请输入您邮箱中的登录码，或点击下方申请新验证码。",
        "continueBtn": "继续 →",
        "loading": "加载中",
        "invalidEmail": "请输入有效的电子邮件地址。",
        "emailVerified": "电子邮件已验证！",
        "setupAccount": "让我们为以下账户设置您的信息"
    }
};

  function applyTranslations(lang) {
    var t = TRANSLATIONS[lang] || TRANSLATIONS['en'];
    console.log('[MMR][login] applyTranslations(' + lang + ') - found', Object.keys(t).length, 'translation keys');
    var titleEl = document.getElementById('appTitle');
    if (titleEl && t.appTitle) titleEl.textContent = t.appTitle;
    var els = document.querySelectorAll('[data-i18n]');
    console.log('[MMR][login] found', els.length, 'elements with data-i18n attribute');
    for (var i = 0; i < els.length; i++) {
      var k = els[i].getAttribute('data-i18n');
      if (t[k] !== undefined) {
        console.log('[MMR][login] translating [data-i18n="' + k + '"] to "' + t[k] + '"');
        els[i].textContent = t[k];
      }
    }
    var pls = document.querySelectorAll('[data-i18n-placeholder]');
    for (var j = 0; j < pls.length; j++) {
      var k2 = pls[j].getAttribute('data-i18n-placeholder');
      if (t[k2] !== undefined) pls[j].placeholder = t[k2];
    }
  }

  // Helper to get translated text for dynamic button updates
  function t(key) {
    var lang = getCurrentLanguage();
    var trans = TRANSLATIONS[lang] || TRANSLATIONS['en'];
    return trans[key] || key;
  }

  function getCurrentLanguage() {
    var stored = localStorage.getItem('portal_lang');
    if (stored && ['en','zh'].indexOf(stored) !== -1) return stored;
    var lang = (navigator.language || 'en').toLowerCase();
    return lang.startsWith('zh') ? 'zh' : 'en';
  }

  function setLanguage(lang) {
    if (['en','zh'].indexOf(lang) !== -1) {
      localStorage.setItem('portal_lang', lang);
      var sel = document.getElementById('languageSelector');
      if (sel) sel.value = lang;
      console.log('[MMR][login] setLanguage(' + lang + ')');
      applyTranslations(lang);
    }
  }

  function initSessionConfig() {
    // Pre-load config on page load to avoid repeated API calls during session
    var cached = getSessionConfig();
    if (cached) {
      console.log('[MMR][login] using cached config from sessionStorage');
      return; // Already loaded, skip server call
    }
    // Load config for this session (triggers server-side cache per sessionID)
    callApi('initializeSessionConfig', { sessionID: SESSION_ID })
      .then(function(data) {
        setSessionConfig(data.config || {});
        console.log('[MMR][login] session config initialized and cached');
      })
      .catch(function(err) {
        console.warn('[MMR][login] failed to initialize session config:', err);
        // Gracefully continue even if config load fails
      });
  }

  function initLanguageSelector() {
    var lang = getCurrentLanguage();
    var sel = document.getElementById('languageSelector');
    if (sel) {
      sel.value = lang;
      sel.addEventListener('change', function(e) { setLanguage(e.target.value); });
    }
    applyTranslations(lang);
  }

  function onPageReady() {
    initLanguageSelector();
    initSessionConfig(); // Pre-load config to avoid repeated API calls
  }

  document.addEventListener('DOMContentLoaded', onPageReady);

  console.log('[MMR][login] page loaded, location:', window.location.href);
  var appBaseUrl = '__SCRIPT_URL__';

  // Navigate top frame (GAS iframe requires target="_top")
  function navigateToPage(page) {
    var url = appBaseUrl + '?page=' + page;
    console.log('[MMR] navigateToPage:', url);
    var a = document.createElement('a');
    a.href = url;
    a.target = '_top';
    a.style.display = 'none';
    document.body.appendChild(a);
    a.click();
  }
  var pendingPage = 'dashboard';
  var currentEmail = '';

  // ── Session Config Cache ──────────────────────────────────
  // Store config in sessionStorage (shared across pages within same session)
  // to avoid repeated API calls. Cache key doesn't include SESSION_ID because
  // we want to reuse config across multiple page navigations.
  function getSessionConfig() {
    var cached = sessionStorage.getItem('MMR_CONFIG');
    if (cached) {
      try {
        return JSON.parse(cached);
      } catch (e) {
        console.warn('[MMR][login] failed to parse cached config:', e);
      }
    }
    return null;
  }

  function setSessionConfig(config) {
    try {
      sessionStorage.setItem('MMR_CONFIG', JSON.stringify(config));
      console.log('[MMR][login] config cached in sessionStorage (persists across pages)');
    } catch (e) {
      console.warn('[MMR][login] failed to cache config:', e);
    }
  }

  // ── Utilities ──────────────────────────────────────────────

  function callApi(fn, payload) {
    console.log('[MMR][login] callApi:', fn, JSON.stringify(payload));
    return new Promise(function(resolve, reject) {
      var req = { requestId: Math.random().toString(36).slice(2), payload: payload };
      google.script.run
        .withSuccessHandler(function(r) {
          var res = JSON.parse(r);
          console.log('[MMR][login]', fn, 'response:', JSON.stringify(res.payload || res));
          if (res.ok) resolve(res.payload);
          else reject(new Error(res.errorMessage));
        })
        .withFailureHandler(function(err) {
          console.error('[MMR][login]', fn, 'failure:', err);
          reject(err);
        })
        [fn](JSON.stringify(req));
    });
  }

  function showMsg(id, text, type) {
    var el = document.getElementById('msg-' + id);
    if (!el) return;
    el.textContent = text;
    el.className = 'msg ' + type;
  }
  function clearMsg(id) {
    var el = document.getElementById('msg-' + id);
    if (el) el.className = 'msg';
  }

  function showState(name) {
    var states = ['email', 'returning', 'new-ask', 'new-verify', 'continue'];
    states.forEach(function(s) {
      var el = document.getElementById('state-' + s);
      if (el) el.style.display = (s === name) ? 'block' : 'none';
    });
    document.getElementById('dbg').textContent = 'State: ' + name;
    // Re-apply translations to newly visible state
    applyTranslations(getCurrentLanguage());
  }

  function goBack() {
    currentEmail = '';
    document.getElementById('emailInput').value = '';
    document.getElementById('otpInput-returning').value = '';
    document.getElementById('otpInput-new').value = '';
    document.getElementById('checkEmailBtn').disabled = false;
    clearMsg('email');
    showState('email');
    document.getElementById('emailInput').focus();
  }

  // ── Google OAuth ───────────────────────────────────────────

  function loginWithGoogle() {
    document.getElementById('googleBtn').disabled = true;
    document.getElementById('googleSpinner').style.display = 'inline';
    callApi('handleGoogleLogin', { email: '' })
      .then(function(data) {
        document.getElementById('googleSpinner').style.display = 'none';
        if (data.isNewMember) {
          sessionStorage.setItem('pending_email', data.email);
          showContinue(
            '<div class="result-box new-member"><div class="result-icon">✅</div>' +
            '<h3>' + t('emailVerified') + '</h3><p>' + t('setupAccount') + '<br/><strong>' +
            esc(data.email) + '</strong></p></div>',
            'newmember'
          );
        } else {
          sessionStorage.setItem('member', JSON.stringify(data.member));
          showContinue(
            '<div class="result-box returning"><div class="result-icon">✅</div>' +
            '<h3>' + t('welcomeBack') + ', ' + esc(data.member.firstName || data.member.email) + '!</h3>' +
            '<p>' + t('memberIDLabel') + ': <strong>' + esc(data.member.memberID) + '</strong></p></div>',
            'dashboard'
          );
        }
      })
      .catch(function(err) {
        document.getElementById('googleSpinner').style.display = 'none';
        document.getElementById('googleBtn').disabled = false;
        showMsg('email', err.message || 'Google sign-in failed. Try email login.', 'error');
      });
  }

  // ── STATE 1 → STATE 2: Check email in database ─────────────

  function checkEmail() {
    var email = document.getElementById('emailInput').value.trim().toLowerCase();
    if (!email || !email.includes('@')) {
      return showMsg('email', t('invalidEmail'), 'error');
    }
    currentEmail = email;
    clearMsg('email');
    var btn = document.getElementById('checkEmailBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner"></span> ' + t('checking') + '…';

    callApi('lookupEmail', { email: email })
      .then(function(data) {
        btn.disabled = false;
        btn.textContent = t('checkEmailBtn');
        if (data.found) {
          // Returning member
          document.getElementById('returning-name').textContent =
            data.firstName || email;
          document.getElementById('returning-memberid').textContent =
            data.memberID || '';
          showState('returning');
          document.getElementById('otpInput-returning').focus();
          // Don't auto-send OTP — a valid code may already exist.
          // Show instructions instead; user types code from inbox or requests a new one.
          showMsg('returning', t('otpInfoMsg'), 'info');
        } else {
          // Not found — ask if new member
          document.getElementById('new-ask-email').textContent = email;
          clearMsg('new-ask');
          showState('new-ask');
        }
      })
      .catch(function(err) {
        btn.disabled = false;
        btn.textContent = 'Continue →';
        showMsg('email', err.message || 'Could not check email. Please try again.', 'error');
      });
  }

  // ── OTP Send ────────────────────────────────────────────────

  function sendOtp(context) {
    // context: 'returning' | 'new'
    var btnId = 'sendBtn-' + context;
    var msgId = context === 'returning' ? 'returning' : 'new-verify';
    var btn = document.getElementById(btnId);
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner"></span> ' + t('sending') + '…';
    clearMsg(msgId);

    callApi('requestEmailOtp', { email: currentEmail })
      .then(function() {
        btn.disabled = false;
        btn.textContent = context === 'returning' ? t('sendNewCodeBtn') : t('resendCodeBtn');
        showMsg(msgId, '✓ Code sent to ' + currentEmail + '. Check your inbox.', 'success');
        var inputId = context === 'returning' ? 'otpInput-returning' : 'otpInput-new';
        document.getElementById(inputId).focus();
      })
      .catch(function(err) {
        btn.disabled = false;
        btn.textContent = context === 'returning' ? t('sendNewCodeBtn') : t('resendCodeBtn');
        showMsg(msgId, err.message || 'Failed to send code. Please try again.', 'error');
      });
  }

  // ── New member: "Yes, register me" → send OTP then show verify ──

  function startNewMemberOtp() {
    var btn = document.getElementById('newMemberYesBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner"></span> ' + t('sendingCode') + '…';
    clearMsg('new-ask');

    callApi('requestEmailOtp', { email: currentEmail })
      .then(function() {
        btn.disabled = false;
        btn.textContent = t('newMemberYes');
        document.getElementById('new-verify-email').textContent = currentEmail;
        clearMsg('new-verify');
        showState('new-verify');
        document.getElementById('otpInput-new').focus();
      })
      .catch(function(err) {
        btn.disabled = false;
        btn.textContent = t('newMemberYes');
        showMsg('new-ask', err.message || 'Failed to send code. Please try again.', 'error');
      });
  }

  // ── OTP Verify ──────────────────────────────────────────────

  function verifyOtp(context) {
    // context: 'returning' | 'new'
    var inputId = context === 'returning' ? 'otpInput-returning' : 'otpInput-new';
    var btnId   = context === 'returning' ? 'verifyBtn-returning' : 'verifyBtn-new';
    var msgId   = context === 'returning' ? 'returning' : 'new-verify';
    var otpCode = document.getElementById(inputId).value.trim();

    if (!otpCode || otpCode.length < 6) {
      return showMsg(msgId, 'Please enter the 6-digit code.', 'error');
    }

    var btn = document.getElementById(btnId);
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner"></span> ' + t('verifying') + '…';
    clearMsg(msgId);

    callApi('verifyEmailOtp', { email: currentEmail, otpCode: otpCode })
      .then(function(data) {
        btn.disabled = false;
        btn.textContent = t('verifyBtn');

        if (data.otpNotFound) {
          // Stay on the same screen, but show the message from the server
          showMsg(msgId, data.message, 'info');
          return;
        }

        if (data.isNewMember) {
          sessionStorage.setItem('pending_email', data.email);
          showContinue(
            '<div class="result-box new-member"><div class="result-icon">✅</div>' +
            '<h3>' + t('emailVerified') + '</h3>' +
            '<p>' + t('setupAccount') + '<br/><strong>' + esc(data.email) + '</strong></p></div>',
            'newmember'
          );
        } else {
          sessionStorage.setItem('member', JSON.stringify(data.member));
          showContinue(
            '<div class="result-box returning"><div class="result-icon">✅</div>' +
            '<h3>' + t('welcomeBack') + ', ' + esc(data.member.firstName || data.member.email) + '!</h3>' +
            '<p>' + t('memberIDLabel') + ': <strong>' + esc(data.member.memberID) + '</strong></p></div>',
            'dashboard'
          );
        }
      })
      .catch(function(err) {
        btn.disabled = false;
        btn.textContent = t('verifyBtn');
        showMsg(msgId, err.message || 'Invalid or expired code. Please try again.', 'error');
      });
  }

  // ── Final continue state ────────────────────────────────────

  function navigateTo(page) {
    // Use the common navigateToPage which uses target="_top"
    navigateToPage(page);
  }

  function showContinue(msgHtml, page) {
    console.log('[MMR][login] showContinue:', page);
    // Show the success message and a button to continue
    // This ensures navigation happens with user activation (click)
    document.getElementById('continue-msg').innerHTML = msgHtml;
    pendingPage = page;
    showState('continue');
  }

  function onContinueClick() {
    var btn = document.getElementById('continueBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner"></span> ' + t('loading') + '…';
    navigateTo(pendingPage);
  }

  // ── HTML escape ─────────────────────────────────────────────
  function esc(str) {
    return String(str || '')
      .replace(/&/g,'&amp;').replace(/</g,'&lt;')
      .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  // ── Init: redirect if already logged in ─────────────────────
  var cached = sessionStorage.getItem('member');
  if (cached) {
    navigateTo('dashboard');
  }
</script>
</body>
</html>
</file>

<file path="web-apps/gas/membership/frontend/page_newmember.html">
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Misty Mountain Runners — New Member Registration</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #f5f5f5; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
    .card { background: #fff; border-radius: 12px; box-shadow: 0 2px 16px rgba(0,0,0,0.10); padding: 40px 36px; width: 100%; max-width: 460px; }
    .logo { text-align: center; margin-bottom: 8px; font-size: 32px; }
    h1 { text-align: center; font-size: 20px; color: #1a1a1a; margin-bottom: 4px; }
    .notice { background: #fff8e1; border: 1px solid #ffe082; border-radius: 8px; padding: 12px 16px; font-size: 14px; color: #5d4037; margin: 20px 0; }
    .notice .email-highlight { font-weight: 700; color: #1a1a1a; }
    .field { margin-bottom: 16px; }
    label { display: block; font-size: 13px; font-weight: 600; color: #555; margin-bottom: 6px; }
    .required { color: #c62828; }
    input[type=text], input[type=tel] { width: 100%; padding: 10px 12px; border: 1px solid #ccc; border-radius: 8px; font-size: 15px; }
    input[readonly] { background: #f5f5f5; color: #888; cursor: default; }
    input:focus { outline: none; border-color: #2d7d46; box-shadow: 0 0 0 2px rgba(45,125,70,0.15); }
    .btn { display: block; width: 100%; padding: 12px; border-radius: 8px; border: none; font-size: 15px; font-weight: 600; cursor: pointer; text-align: center; }
    .btn-primary { background: #2d7d46; color: #fff; margin-top: 8px; }
    .btn-primary:hover { background: #235f36; }
    .btn-primary:disabled { opacity: 0.6; cursor: not-allowed; }
    .btn-link { background: none; border: none; color: #2d7d46; cursor: pointer; font-size: 13px; margin-top: 12px; text-decoration: underline; }
    .msg { font-size: 14px; padding: 10px 12px; border-radius: 8px; margin-bottom: 16px; display: none; }
    .msg.error { background: #fdecea; color: #c62828; display: block; }
    .success-view { display: none; text-align: center; padding: 20px 0; }
    .success-icon { font-size: 52px; margin-bottom: 16px; }
    .member-id-badge { display: inline-block; background: #e8f5e9; color: #1b5e20; font-size: 28px; font-weight: 800; letter-spacing: 2px; padding: 12px 28px; border-radius: 10px; margin: 12px 0 20px; border: 2px solid #a5d6a7; }
    .success-view p { color: #555; font-size: 15px; line-height: 1.6; margin-bottom: 20px; }
    .language-selector { padding: 5px 9px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.35); background: rgba(255,255,255,0.12); color: #fff; font-size: 13px; cursor: pointer; }
    .language-selector:hover { background: rgba(255,255,255,0.22); }
  </style>
</head>
<body>

<div class="card">
  <div class="logo">🏃</div>
  <div style="display:flex;align-items:center;gap:16px;"><h1 id="appTitle" data-i18n="appTitle">🏃 Misty Mountain Runners</h1>
    <select id="languageSelector" class="language-selector"><option value="en">EN</option><option value="zh">中文</option></select></div>

  <!-- Registration form -->
  <div id="formView">
    <div class="notice">
      <span data-i18n="notRecognized">We don't recognize</span> <span class="email-highlight" id="emailDisplay">this email</span>. <span data-i18n="completeForm">If this is your correct email and you're signing up, please complete the form below.</span>
    </div>

    <div id="msg" class="msg"></div>

    <div class="field">
      <label data-i18n="emailVerified">Email (verified)</label>
      <input type="text" id="emailField" readonly />
    </div>
    <div class="field">
      <label data-i18n="firstName">First Name <span class="required">*</span></label>
      <input type="text" id="firstName" data-i18n-placeholder="firstNamePlaceholder" placeholder="Your first name" />
    </div>
    <div class="field">
      <label data-i18n="lastName">Last Name <span class="required">*</span></label>
      <input type="text" id="lastName" data-i18n-placeholder="lastNamePlaceholder" placeholder="Your last name" />
    </div>
    <div class="field">
      <label data-i18n="phoneNumber">Phone Number</label>
      <input type="tel" id="phoneNumber" data-i18n-placeholder="phonePlaceholder" placeholder="e.g. 917-555-1234" />
    </div>
    <div class="field">
      <label data-i18n="district">District</label>
      <input type="text" id="district" data-i18n-placeholder="districtPlaceholder" placeholder="e.g. Queens, Brooklyn" />
    </div>

    <button class="btn btn-primary" id="submitBtn" onclick="submitRegistration()" data-i18n="registerBtn">Register →</button>
    <button class="btn-link" onclick="goToLogin()" data-i18n="notYourEmail">← Not your email? Sign in again</button>
  </div>

  <!-- Success view -->
  <div id="successView" class="success-view">
    <div class="success-icon">🎉</div>
    <h2 style="font-size:20px;color:#1a1a1a;margin-bottom:8px;" data-i18n="welcome">Welcome to Misty Mountain Runners!</h2>
    <p data-i18n="registrationComplete">Your registration is complete. Your member ID is:</p>
    <div class="member-id-badge" id="memberIdBadge">—</div>
    <p data-i18n="nextSetup">Next, set up your membership by submitting your annual fee.</p>
    <button class="btn btn-primary" id="toRenewalBtn" onclick="onGoToRenewal()" data-i18n="setupMembership">Set Up Membership →</button>
  </div>
</div>

<script>
  // ── i18n ─────────────────────────────────────────────────
  var TRANSLATIONS = {
    "en": {
        "appTitle": "🏃 Misty Mountain Runners",
        "notRecognized": "We don't recognize",
        "completeForm": "If this is your correct email and you're signing up, please complete the form below.",
        "emailVerified": "Email (verified)",
        "firstName": "First Name",
        "lastName": "Last Name",
        "phoneNumber": "Phone Number",
        "district": "District",
        "registerBtn": "Register →",
        "notYourEmail": "← Not your email? Sign in again",
        "welcome": "Welcome to Misty Mountain Runners!",
        "registrationComplete": "Your registration is complete. Your member ID is:",
        "nextSetup": "Next, set up your membership by submitting your annual fee.",
        "setupMembership": "Set Up Membership →",
        "firstNamePlaceholder": "Your first name",
        "lastNamePlaceholder": "Your last name",
        "phonePlaceholder": "e.g. 917-555-1234",
        "districtPlaceholder": "e.g. Queens, Brooklyn"
    },
    "zh": {
        "appTitle": "🏃 岚山跑团",
        "notRecognized": "我们无法识别",
        "completeForm": "如果这是您正确的电子邮件且您正在注册，请完成下面的表单。",
        "emailVerified": "电子邮件（已验证）",
        "firstName": "名字",
        "lastName": "姓氏",
        "phoneNumber": "电话号码",
        "district": "地区",
        "registerBtn": "注册 →",
        "notYourEmail": "← 不是您的电子邮件？重新登录",
        "welcome": "欢迎加入岚山跑团！",
        "registrationComplete": "您的注册已完成。您的会员编号是：",
        "nextSetup": "接下来，通过提交年费来设置您的会员资格。",
        "setupMembership": "设置会员资格 →",
        "firstNamePlaceholder": "您的名字",
        "lastNamePlaceholder": "您的姓氏",
        "phonePlaceholder": "例如 917-555-1234",
        "districtPlaceholder": "例如 Queens, Brooklyn"
    }
};

  function applyTranslations(lang) {
    var t = TRANSLATIONS[lang] || TRANSLATIONS['en'];
    var titleEl = document.getElementById('appTitle');
    if (titleEl && t.appTitle) titleEl.textContent = t.appTitle;
    var els = document.querySelectorAll('[data-i18n]');
    for (var i = 0; i < els.length; i++) {
      var k = els[i].getAttribute('data-i18n');
      if (t[k] !== undefined) els[i].textContent = t[k];
    }
    var pls = document.querySelectorAll('[data-i18n-placeholder]');
    for (var j = 0; j < pls.length; j++) {
      var k2 = pls[j].getAttribute('data-i18n-placeholder');
      if (t[k2] !== undefined) pls[j].placeholder = t[k2];
    }
  }

  function getCurrentLanguage() {
    var stored = localStorage.getItem('portal_lang');
    if (stored && ['en','zh'].indexOf(stored) !== -1) return stored;
    var lang = (navigator.language || 'en').toLowerCase();
    return lang.startsWith('zh') ? 'zh' : 'en';
  }

  function setLanguage(lang) {
    if (['en','zh'].indexOf(lang) !== -1) {
      localStorage.setItem('portal_lang', lang);
      var sel = document.getElementById('languageSelector');
      if (sel) sel.value = lang;
      applyTranslations(lang);
    }
  }

  function initLanguageSelector() {
    var lang = getCurrentLanguage();
    var sel = document.getElementById('languageSelector');
    if (sel) {
      sel.value = lang;
      sel.addEventListener('change', function(e) { setLanguage(e.target.value); });
    }
    applyTranslations(lang);
  }
  document.addEventListener('DOMContentLoaded', initLanguageSelector);

  console.log('[MMR][newmember] page script started, location:', window.location.href);
  var appBaseUrl = '__SCRIPT_URL__';

  // Navigate top frame (GAS iframe requires target="_top")
  function navigateToPage(page) {
    var url = appBaseUrl + '?page=' + page;
    console.log('[MMR] navigateToPage:', url);
    var a = document.createElement('a');
    a.href = url;
    a.target = '_top';
    a.style.display = 'none';
    document.body.appendChild(a);
    a.click();
  }
  console.log('[MMR][newmember] appBaseUrl:', appBaseUrl);

  document.addEventListener('click', function(e) {
    var a = e.target.closest('a[href]');
    if (a) { var h = a.getAttribute('href'); if (h && h.charAt(0) === '?') { a.href = appBaseUrl + h; a.target = '_top'; } }
  });

  function callApi(fn, payload) {
    console.log('[MMR][newmember] callApi:', fn, JSON.stringify(payload));
    return new Promise((resolve, reject) => {
      const req = { requestId: Math.random().toString(36).slice(2), payload };
      google.script.run
        .withSuccessHandler(r => {
          const res = JSON.parse(r);
          console.log('[MMR][newmember]', fn, 'success:', JSON.stringify(res.payload || res));
          if (res.ok) resolve(res.payload);
          else reject(new Error(res.errorMessage));
        })
        .withFailureHandler(err => {
          console.error('[MMR][newmember]', fn, 'failure:', err);
          reject(err);
        })
        [fn](JSON.stringify(req));
    });
  }

  function showMsg(text) {
    const el = document.getElementById('msg');
    el.textContent = text;
    el.className = 'msg error';
  }

  function goToLogin() {
    console.log('[MMR][newmember] navigating to login');
    navigateToPage('login');
  }

  function onGoToRenewal() {
    console.log('[MMR][newmember] navigating to renewal');
    navigateToPage('dashboard');
  }

  function submitRegistration() {
    const email = document.getElementById('emailField').value.trim();
    const firstName = document.getElementById('firstName').value.trim();
    const lastName = document.getElementById('lastName').value.trim();
    const phoneNumber = document.getElementById('phoneNumber').value.trim();
    const district = document.getElementById('district').value.trim();

    if (!firstName) return showMsg('First name is required.');
    if (!lastName) return showMsg('Last name is required.');

    console.log('[MMR][newmember] submitting registration for:', email, firstName, lastName);
    const btn = document.getElementById('submitBtn');
    btn.disabled = true;
    btn.textContent = 'Registering…';

    callApi('createNewMember', { email, firstName, lastName, phoneNumber, district })
      .then(data => {
        console.log('[MMR][newmember] member created:', data.member && data.member.memberID);
        sessionStorage.setItem('member', JSON.stringify(data.member));
        document.getElementById('memberIdBadge').textContent = data.member.memberID;
        document.getElementById('formView').style.display = 'none';
        document.getElementById('successView').style.display = 'block';
      })
      .catch(err => {
        console.error('[MMR][newmember] registration error:', err.message);
        showMsg(err.message || 'Registration failed. Please try again.');
        btn.disabled = false;
        btn.textContent = 'Register →';
      });
  }

  // Populate email from sessionStorage
  const pendingEmail = sessionStorage.getItem('pending_email') || '';
  console.log('[MMR][newmember] pending_email from sessionStorage:', pendingEmail);
  if (!pendingEmail) {
    // No pending email — redirect to login
    console.log('[MMR][newmember] no pending_email, redirecting to login');
    navigateToPage('login');
  } else {
    document.getElementById('emailDisplay').textContent = pendingEmail;
    document.getElementById('emailField').value = pendingEmail;
  }
</script>
</body>
</html>
