        </div>

        <!-- Annotation form -->
        <div class="sidebar-panel" id="annotation-panel">
            <h3>Annotation</h3>
            <form id="annotation-form" onsubmit="return false">
                <input type="hidden" name="file_path" value="{{ rec.file_path }}">
                <input type="hidden" name="file_name" value="{{ rec.file_name }}">
                <input type="hidden" name="quality_score" value="{{ rec.quality_score }}">
                <input type="hidden" name="people_count" value="{{ rec.people_count }}">
