            <div class="detail-row">
                <span class="label">People</span>
                <span class="value">{{ rec.people_count if rec.people_count is not none else '—' }}</span>
            </div>
            <div class="detail-row">
                <span class="label">Facing camera</span>
                <span class="value">{{ rec.people_facing_camera if rec.people_facing_camera is not none else '—' }}</span>
            </div>
            <div class="detail-row">
                <span class="label">Bib primary</span>
                <span class="value">
                    {% if rec.bib_primary %}
                    {{ rec.bib_primary.number if rec.bib_primary is mapping else rec.bib_primary }}
                    {% else %}—{% endif %}
                </span>
            </div>
            <div class="detail-row">
                <span class="label">Bib facing</span>
                <span class="value">{{ rec.bib_facing or '—' }}</span>
            </div>
            {% if rec.bib_related %}
            <div class="detail-row">
                <span class="label">Related bibs</span>
                <span class="value">{{ rec.bib_related | length }}</span>
            </div>
            {% endif %}
            {% if rec.outfit_signatures %}
            <div class="detail-row">
                <span class="label">Outfit sigs</span>
                <span class="value">{{ rec.outfit_signatures | length }}</span>
            </div>
            {% endif %}
