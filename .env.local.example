# MMR Photo Manager — Environment Variables
# Copy this file to .env.local and fill in your Azure values.
# .env.local is in .gitignore and will never be committed to the repo.

# ── Azure Face API ────────────────────────────────────────────────
# Azure Portal → your Face resource → Keys and Endpoint
AZURE_FACE_KEY=your_face_api_key_here
AZURE_FACE_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/

# ── PersonGroup ID ────────────────────────────────────────────────
# Logical name for the MMR member group. Lowercase letters, digits, hyphens only.
# Can be anything — used as the identifier when enrolling + identifying members.
AZURE_FACE_GROUP_ID=mmr-members

# ── (Optional) Azure Blob Storage ────────────────────────────────
# Only needed if you want to upload photos to Blob and pass a URL to Face API.
# For local file testing these can be left blank.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=photos
