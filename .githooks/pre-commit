#!/usr/bin/env bash
# Pre-commit hook: run circular import detection when mmr-admin Python files change.
# To skip (emergency only): git commit --no-verify
#
# Setup (one-time per clone):
#   git config core.hooksPath .githooks

set -e

# Check if any staged files are in mmr-admin/*.py
STAGED_ADMIN=$(git diff --cached --name-only --diff-filter=ACMR | grep '^mmr-admin/.*\.py$' || true)

if [ -z "$STAGED_ADMIN" ]; then
    exit 0  # no mmr-admin Python files staged — nothing to check
fi

echo "🔍 mmr-admin files changed — running import check..."

# Run the import test from the mmr-admin directory
cd "$(git rev-parse --show-toplevel)/mmr-admin"

if python3 test_imports.py; then
    echo "✅ Import check passed."
else
    echo ""
    echo "❌ Import check failed. Fix circular/broken imports before committing."
    echo "   To bypass (emergency): git commit --no-verify"
    exit 1
fi
