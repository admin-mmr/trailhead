{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "none",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": false,
    "outDir": "./dist",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests"]
}
