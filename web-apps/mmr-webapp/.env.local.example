# ─── Database ────────────────────────────────────────────────
DATABASE_URL=mysql://mmradmin:<PASSWORD>@mmr-mysql-v4.mysql.database.azure.com:3306/mmrdb?ssl=true

# ─── Auth (custom JWT session cookie) ────────────────────────
JWT_SECRET=<generate: openssl rand -base64 64>
JWT_EXPIRY=7d

# ─── NextAuth (social login) ──────────────────────────────────
# Must match NEXT_PUBLIC_APP_URL in production.
# Generate: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=<generate: openssl rand -base64 32>

# ── Google ────────────────────────────────────────────────────
# https://console.cloud.google.com → Credentials → OAuth 2.0
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Apple ─────────────────────────────────────────────────────
# https://developer.apple.com → Certificates → Sign In with Apple
# APPLE_ID       = Services ID (e.g. com.mmrunners.webapp.signin)
# APPLE_SECRET   = Private key content (.p8) — include full -----BEGIN/END----- block
# APPLE_TEAM_ID  = 10-char Team ID from developer.apple.com
# APPLE_KEY_ID   = Key ID from the .p8 filename
APPLE_ID=
APPLE_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# ── Microsoft ─────────────────────────────────────────────────
# https://portal.azure.com → App registrations → New registration
# Tenant: "common" allows both personal and work accounts
# Redirect URI: {NEXTAUTH_URL}/api/auth/callback/microsoft-entra-id
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Facebook ─────────────────────────────────────────────────
# https://developers.facebook.com → My Apps → Create App
# Product: Facebook Login
# Redirect URI: {NEXTAUTH_URL}/api/auth/callback/facebook
# Note: Facebook requires HTTPS — use ngrok or similar for local testing
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ── Yahoo ────────────────────────────────────────────────────
# https://developer.yahoo.com → My Apps → Create App
# Redirect URI: {NEXTAUTH_URL}/api/auth/callback/yahoo
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# ─── Stripe ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_INDIVIDUAL_PRICE_ID=price_...
STRIPE_FAMILY_PRICE_ID=price_...

# ─── Azure Communication Services (Email) ────────────────────
AZURE_COMM_CONNECTION_STRING=endpoint=https://mmr-comm.communication.azure.com/;...
EMAIL_FROM=no-reply@mmrunners.org

# ─── Azure Blob Storage ───────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=mmrstorage;...
AZURE_STORAGE_CONTAINER=media

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://www.mmrunners.org
NEXT_PUBLIC_SITE_NAME=Misty Mountain Runners
