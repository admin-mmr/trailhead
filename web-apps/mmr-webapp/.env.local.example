# ─── Database ────────────────────────────────────────────────
DATABASE_URL=mysql://mmradmin:<PASSWORD>@mmr-mysql-v4.mysql.database.azure.com:3306/mmrdb?ssl=true

# ─── Auth (custom JWT session cookie) ────────────────────────
JWT_SECRET=<generate: openssl rand -base64 64>
JWT_EXPIRY=7d

# ─── NextAuth (social login) ──────────────────────────────────
# Must match NEXT_PUBLIC_APP_URL in production.
# Generate: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=<generate: openssl rand -base64 32>

# ── Google ────────────────────────────────────────────────────
# https://console.cloud.google.com → Credentials → OAuth 2.0
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Microsoft ─────────────────────────────────────────────────
# https://portal.azure.com → App registrations → New registration
# Tenant: "common" allows both personal and work accounts
# Redirect URI: {NEXTAUTH_URL}/api/auth/callback/microsoft-entra-id
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ─── Email (Google Apps Script webhook) ──────────────────────
# Get from GitHub Secrets: Settings → Secrets and variables → Actions
GAS_WEBHOOK_URL=https://script.google.com/macros/s/{DEPLOYMENT_ID}/exec

# ─── Azure Blob Storage ───────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=mmrstorage;...
AZURE_STORAGE_CONTAINER=media

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://www.mmrunners.org
NEXT_PUBLIC_SITE_NAME=Misty Mountain Runners

# ─── Stripe (TEST MODE — swap for live keys when ready) ──────
# Dashboard → Developers → API keys (use the sk_test_… key)
STRIPE_SECRET_KEY=sk_test_xxx
# Local dev: `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# prints a whsec_… value. Production: create a webhook endpoint for
# checkout.session.completed and copy its signing secret.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Publishable key (pk_test_…) — not used by hosted Checkout redirect today,
# reserved for future embedded elements (per P1k design)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
